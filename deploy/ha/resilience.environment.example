# Private /etc/perimeter-resilience.env, root:root 0600. Values provisioned locally.
# Use the existing cluster token and actual SQL destination; never commit values.
PERIMETER_HA_TOKEN=CHANGE_EXISTING_CLUSTER_TOKEN
PERIMETER_HA_SQL=CHANGE_EXISTING_CONTROL_CONNECTION_OR_SQL_HA_LISTENER
PERIMETER_OBSERVER_SQL=CHANGE_DEDICATED_READ_ONLY_SQL_CONNECTION
# Optional delivery to an existing operator-managed notification endpoint.
# PERIMETER_ALERT_WEBHOOK=https://existing.internal.notification.endpoint
# PERIMETER_ALERT_TOKEN=CHANGE_PRIVATE_NOTIFICATION_TOKEN
