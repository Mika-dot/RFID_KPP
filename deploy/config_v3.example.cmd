@echo off
rem Copy this file to config_v3.cmd and fill real values locally.
rem NEVER commit deploy\config_v3.cmd with production credentials.
if not defined ROOT set "ROOT=%~dp0.."
for %%I in ("%ROOT%") do set "ROOT=%%~fI"

set "SQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=<SQL_SERVER>;DATABASE=<SQL_DATABASE>;UID=<SQL_USER>;PWD=<SQL_PASSWORD>;Encrypt=yes;TrustServerCertificate=yes;"
set "KPP_CONN_STR=%SQL_CONN%"
set "KPP_TASK_CONN_STR=%SQL_CONN%"
set "KPP_WEB_DB_CONNECTION=%SQL_CONN%"
set "RFID_DB_CONNECTION=%SQL_CONN%"
set "KPP_MIGRATION_TRUSTED_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=<SQL_SERVER>;DATABASE=<SQL_DATABASE>;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;"

rem RFID reader
set "RFID_DLL_PATH=%ROOT%\RFID_reader_v4\UHFAPI.dll"
set "RFID_READER_IP=<RFID_READER_IP>"
set "RFID_READER_PORT=8888"
set "RFID_SPOOL_PATH=%ROOT%\runtime\rfid_spool_v4.sqlite"
set "RFID_READER_LOCK_FILE=%ROOT%\runtime\rfid_reader_v4.lock"
set "RFID_RECONNECT_DELAY_SEC=5"
set "RFID_RECONNECT_UNCERTAIN_SEC=60"
set "RFID_SPOOL_RETENTION_DAYS=30"
set "RFID_SPOOL_WARN_MB=4096"
set "RFID_CONSOLE_OUTPUT=1"
set "RFID_HEARTBEAT_SEC=10"
set "RFID_SDK_CALL_TIMEOUT_SEC=30"
set "RFID_SDK_ERROR_STREAK_LIMIT=5"
set "RFID_READER_LOOP_WATCHDOG_SEC=90"
set "RFID_DELIVERY_WRITER_WATCHDOG_SEC=90"

rem RFID semantic business-flow watchdog / self-heal
rem A quiet gate is valid. Failure is confirmed only when independent
rem Perimeter sources show activity while raw RFID remains stale.
set "RFID_BUSINESS_CHECK_SEC=15"
set "RFID_BUSINESS_STALL_SEC=900"
set "RFID_BUSINESS_EVIDENCE_WINDOW_SEC=1800"
set "RFID_BUSINESS_MIN_VIDEO_EVENTS=2"
set "RFID_BUSINESS_SELF_HEAL_SEC=60"
set "RFID_BUSINESS_MAX_RESTARTS=3"
set "RFID_BUSINESS_STATE_PATH=%ROOT%\runtime\rfid_business_flow_state.json"

rem RusGuard source and destination
set "SRC_SERVER=<RUSGUARD_SQL_SERVER>"
set "SRC_DATABASE=<RUSGUARD_DATABASE>"
set "SRC_USERNAME=<RUSGUARD_USER>"
set "SRC_PASSWORD=<RUSGUARD_PASSWORD>"
set "SRC_DRIVER=ODBC Driver 18 for SQL Server"
set "DST_SERVER=<SQL_SERVER>"
set "DST_DATABASE=<SQL_DATABASE>"
set "DST_USERNAME=<SQL_USER>"
set "DST_PASSWORD=<SQL_PASSWORD>"
set "DST_DRIVER=ODBC Driver 18 for SQL Server"
set "RUSGUARD_POLL_SEC=15"
set "RUSGUARD_BATCH_SIZE=5000"
set "RUSGUARD_HEARTBEAT_SEC=15"
set "RUSGUARD_BOOTSTRAP_FROM_DEST_MAX=1"
set "RUSGUARD_LOCK_FILE=%ROOT%\runtime\rusguard_sync_v2.lock"
set "RUSGUARD_WATCHDOG_SEC=180"

rem RTSP / YOLO
set "RFID_MODEL_PATH=%ROOT%\RTSP\runs\detect\rfid_forklift_reel2\weights\best.pt"
set "RFID_RTSP_0=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_0_IP>:554/Streaming/Channels/101"
set "RFID_RTSP_1=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_1_IP>:554/Streaming/Channels/101"
set "RFID_CAMERA_IDS=0,1"
set "RFID_MASK_ENABLED=1"
set "RFID_MASK_0=%ROOT%\RTSP\Mask_0.jpg"
set "RFID_MASK_1=%ROOT%\RTSP\Mask_1.jpg"
set "RFID_VIDEO_SPOOL=%ROOT%\runtime\video_spool_v3.sqlite"
set "RFID_VIDEO_LOCK_FILE=%ROOT%\runtime\video_v3.lock"
set "RFID_VIDEO_SPOOL_RETENTION_DAYS=30"
set "RFID_VIDEO_SPOOL_WARN_MB=8192"
set "RFID_REEL_CLASS_NAME=cable_reel"
set "RFID_CONFIDENCE_THRESHOLD=0.25"
set "RFID_IOU_THRESHOLD=0.45"
set "RFID_YOLO_DEVICE=cpu"
set "RFID_MAX_FRAME_AGE_SEC=2.0"
set "RFID_RTSP_RECONNECT_SEC=3"
set "RFID_RTSP_BACKEND=FFMPEG"
set "RFID_SET_CAPTURE_BUFFER=0"
set "RFID_RTSP_READ_WATCHDOG_SEC=45"
set "RFID_TRACK_MAX_DISTANCE_PX=140"
set "RFID_TRACK_MAX_AGE_SEC=4"
set "RFID_TRACK_MIN_HITS=2"
set "RFID_TRANSITION_MIN_SEC=0.05"
set "RFID_TRANSITION_WINDOW_SEC=30"
set "RFID_VIDEO_GROUP_WINDOW_SEC=2.0"
set "RFID_REEL_NEARBY_THRESHOLD_PX=300"
set "RFID_IMAGE_QUALITY=85"
set "RFID_IMAGE_MAX_WIDTH=640"
set "RFID_IMAGE_MAX_HEIGHT=480"
set "RFID_WINDOW_WIDTH=640"
set "RFID_WINDOW_HEIGHT=480"
set "RFID_HEADLESS=0"
set "RFID_VIDEO_HEARTBEAT_SEC=10"
set "RFID_YOLO_WATCHDOG_SEC=120"

rem KPP business rules
set "KPP_TASK_MATCH_WINDOW_HOURS=24"
set "KPP_ALLOW_UNIQUE_EPC_REEL=0"
set "KPP_NON_REEL_TAGS_FILE=%ROOT%\deploy\non_reel_tags.txt"
set "KPP_RFID_DISAPPEAR_TIMEOUT_SEC=35"
set "KPP_SESSION_MAX_DURATION_SEC=900"
set "KPP_RFID_LATE_TOLERANCE_SEC=2"
set "KPP_LIVE_SOURCE_LAG_SEC=120"
set "KPP_BACKLOG_QUIET_CLOSE_SEC=300"
set "KPP_PASSAGE_GROUP_WINDOW_SEC=4"
set "KPP_OUTER_ANTENNAS=2,3"
set "KPP_INNER_ANTENNAS=1,4"
set "KPP_VIDEO_WINDOW_BEFORE_SEC=60"
set "KPP_VIDEO_WINDOW_AFTER_SEC=60"
set "KPP_VIDEO_EXPECTED_LAG_IN_SEC=0"
set "KPP_VIDEO_EXPECTED_LAG_OUT_SEC=0"
set "KPP_VIDEO_EXPECTED_LAG_UNKNOWN_SEC=0"
set "KPP_SKUD_WINDOW_BEFORE_SEC=90"
set "KPP_SKUD_WINDOW_AFTER_SEC=90"
set "KPP_SKUD_EXPECTED_LAG_IN_SEC=0"
set "KPP_SKUD_EXPECTED_LAG_OUT_SEC=0"
set "KPP_SKUD_EXPECTED_LAG_UNKNOWN_SEC=0"
set "KPP_RECHECK_INTERVAL_SEC=60"
set "KPP_STATUS_INTERVAL_SEC=10"
set "KPP_UNKNOWN_RECHECK_HOURS=30"
set "KPP_REGISTRY_CACHE_HOURS=72"
set "KPP_EXTERNAL_RECHECK_HOURS=6"
set "KPP_WAREHOUSE_RECHECK_SEC=60"
set "KPP_WAREHOUSE_RECHECK_HOURS=168"
set "KPP_WAREHOUSE_RECHECK_BATCH=500"
set "KPP_WATCHDOG_SEC=180"
set "KPP_CONSECUTIVE_FAILURE_RESTART=5"

rem Web
set "KPP_WEB_HOST=0.0.0.0"
set "KPP_WEB_PORT=5050"
set "KPP_WEB_AUTH_REQUIRED=1"
set "KPP_WEB_AUTH_USER=<WEB_USER>"
set "KPP_WEB_AUTH_PASSWORD=<WEB_PASSWORD>"
set "KPP_WEB_LOCK_FILE=%ROOT%\runtime\web_v3.lock"
set "KPP_WEB_DEFAULT_LIMIT=200"
set "KPP_WEB_THREADS=24"
set "KPP_WEB_HEARTBEAT_SEC=15"
set "KPP_WEB_SLOW_REQUEST_SEC=2"
set "KPP_WEB_MAX_LIMIT=5000"
set "KPP_WEB_SUMMARY_HOURS=24"
set "KPP_WEB_CHART_DAYS=7"
set "KPP_WEB_REFRESH_SEC=20"

rem Optional local AI. Leave empty to disable event-data forwarding to an LLM.
set "KPP_AI_BASE_URL="
set "KPP_AI_FALLBACK_BASE_URL="

rem Observability uses existing service ports 18101..18105 and existing Sentry projects.
set "PERIMETER_RELEASE=3.4.7-resilience-audit"
set "PERIMETER_HEALTH_HOST=127.0.0.1"
set "PERIMETER_HEARTBEAT_SEC=10"
set "PERIMETER_ENVIRONMENT=production"
set "PERIMETER_TRACES_SAMPLE_RATE=0.1"
